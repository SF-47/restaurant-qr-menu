{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "trailingSlash": false,
    "rewrites": [
      { "source": "/admin-demo", "destination": "/index.html" },
      { "source": "/6975fc7b-e74c-8330-b6f1-8fe2f9b3d526", "destination": "/index.html" }
    ]
  }
}
